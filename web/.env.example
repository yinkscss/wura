# Copy to .env.local. Every variable is optional: with none set, the app runs
# in mock mode (mock email sign-in, example balances, nothing signed).

# Privy app ID. When set, sign-in uses real email codes and creates a Stellar
# wallet with Privy. When empty, sign-in is mocked (any 6-digit code works).
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side only. Lets the server confirm that the Stellar address really
# belongs to the signed-in Privy user (GET api.privy.io/v1/users/{id}).
# A read-only app secret is enough. Never expose this to the browser.
PRIVY_APP_SECRET=

# Privy access-token verification key (PEM, public), from Privy Dashboard >
# Configuration > App settings. Recommended. Keep the line breaks, or write
# them as \n on one line.
PRIVY_VERIFICATION_KEY=

# Signs the session cookie. Required (32+ characters) once Privy or testnet
# signing is on. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Money mode. "mock" (default): nothing is signed or broadcast.
# "testnet": USDC sends are real transactions on Stellar TESTNET.
# Swaps and site payments stay simulated (refused) until live quotes exist.
MONEY_MODE=mock

# Who signs testnet transactions:
#   "privy" (default) — the user's Privy Stellar wallet signs in the browser.
#                       Needs NEXT_PUBLIC_PRIVY_APP_ID, PRIVY_APP_SECRET, SESSION_SECRET.
#   "server-dev"      — a throwaway testnet key derived per email on the server.
#                       For local testing and team demos without Privy. Testnet only.
TESTNET_SIGNER=

# Optional for server-dev: secret used to derive dev keys (defaults to SESSION_SECRET).
DEV_KEY_SECRET=

# USDC issuer on testnet. Empty = Circle's testnet USDC
# (GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5; get some at faucet.circle.com).
# `npm run testnet -- test-usdc` prints a private test issuer for offline testing.
STELLAR_USDC_ISSUER=

# Real testnet accounts for demo contacts, e.g. "Tunde:G...,Ada:G...".
# `npm run testnet -- contacts Tunde Ada` creates them and prints this line.
TESTNET_CONTACTS=

# Optional Horizon override (defaults to https://horizon-testnet.stellar.org).
STELLAR_HORIZON_URL=

# Demo the "venue can't be quoted" path, e.g. "soroswap" or "sdex,aquarius".
MOCK_UNAVAILABLE_VENUES=
