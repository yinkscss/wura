# Copy to .env.local. Every variable is optional: with none set, the app runs
# in mock mode (mock email sign-in, example balances, nothing signed).

# Privy app ID. When set, sign-in uses real email codes and creates a Stellar
# wallet with Privy. When empty, sign-in is mocked (any 6-digit code works).
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side only. Lets the server confirm that the Stellar address really
# belongs to the signed-in Privy user (GET api.privy.io/v1/users/{id}).
# A read-only app secret is enough. Never expose this to the browser.
PRIVY_APP_SECRET=

# Privy access-token verification key (PEM, public), from Privy Dashboard >
# Configuration > App settings. Recommended. Keep the line breaks, or write
# them as \n on one line.
PRIVY_VERIFICATION_KEY=

# Signs the session cookie. Required (32+ characters) once Privy or testnet
# signing is on. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Money mode. "mock" (default): nothing is signed or broadcast.
# "testnet": USDC sends are real transactions on Stellar TESTNET.
# "mainnet": REAL MONEY. Production only. The server refuses to start on mainnet
#   in a Vercel Preview, with TESTNET_SIGNER=server-dev, with AGENT_KEY_SECRET set
#   (chat approvals wait for the D2 conditions), without SESSION_SECRET, or with a
#   testnet USDC issuer or Horizon. See docs/mainnet-plan.md.
# Swaps and site payments stay simulated (refused) until live quotes exist.
MONEY_MODE=mock

# Kill switch. Set to 1 to stop every real money move (build and submit) at once,
# on testnet or mainnet, without deploying new code. Mock mode is unaffected.
MONEY_KILL=

# Who signs testnet transactions:
#   "privy" (default) — the user's Privy Stellar wallet signs in the browser.
#                       Needs NEXT_PUBLIC_PRIVY_APP_ID, PRIVY_APP_SECRET, SESSION_SECRET.
#   "server-dev"      — a throwaway testnet key derived per email on the server.
#                       For local testing and team demos without Privy. Testnet only.
TESTNET_SIGNER=

# Optional for server-dev: secret used to derive dev keys (defaults to SESSION_SECRET).
DEV_KEY_SECRET=

# USDC issuer on testnet. Empty = Circle's testnet USDC
# (GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5; get some at faucet.circle.com).
# `npm run testnet -- test-usdc` prints a private test issuer for offline testing.
STELLAR_USDC_ISSUER=

# Testnet only (mainnet refuses to start with this set). Real testnet accounts for demo contacts, e.g. "Tunde:G...,Ada:G...".
# `npm run testnet -- contacts Tunde Ada` creates them and prints this line.
TESTNET_CONTACTS=

# Optional Horizon override (defaults to https://horizon-testnet.stellar.org).
STELLAR_HORIZON_URL=

# Swap quotes. "live" (default): real, read-only prices from Stellar MAINNET
# (SDEX via Horizon, Aquarius, Soroswap). "mock": fixed example prices that
# match the design mockups. Executing a swap is simulated either way.
QUOTE_SOURCE=live

# Soroswap API key (free at console.soroswap.finance). Without it Soroswap is
# shown as "not connected" and the other venues are still compared.
# If the key is injected by a network proxy (Claude Code cloud sessions), set
# this to any placeholder and start the server with NODE_USE_ENV_PROXY=1.
SOROSWAP_API_KEY=

# Naira asset to quote, as CODE:ISSUER:CONTRACT. Default: NGNC (Link).
QUOTE_NGN_ASSET=

# Optional mainnet Horizon override for quotes (default https://horizon.stellar.org).
QUOTE_HORIZON_URL=

# With QUOTE_SOURCE=mock: demo the "venue can't be quoted" path, e.g. "soroswap".
MOCK_UNAVAILABLE_VENUES=

# Naira partner. "mock" (default): a fictional top-up, nothing real.
# "link": the live partner on Stellar MAINNET, no key needed. Reads its limits,
# signs the wallet in to it and starts a top-up on the partner's own page. A
# top-up (kept as naira, or as dollars) is refused unless the wallet can receive it on mainnet. Cash-outs
# start the same way and stop before the wallet pays. See docs/money-side.md.
RAMP_PROVIDER=mock

# Postgres connection string. When set, wallet state and the transaction log are
# stored in Postgres (e.g. Neon from the Vercel Marketplace; use the pooled URL).
# When empty, state lives in server memory (mock/demo only).
DATABASE_URL=

# Max connections per server instance (default 5). Keep it small on serverless.
DATABASE_POOL_MAX=

# ---------- Chat brain ----------
# Pick any model. With all three of LLM_PROVIDER, LLM_MODEL and LLM_API_KEY set,
# the model reads chat messages and calls the preview-only money functions (it
# can't approve or send anything). Without them, or if the model call fails,
# the built-in rule parser answers. AGENT_BRAIN=rules forces the parser.
#
# LLM_PROVIDER: anthropic | openai-compatible | openai | deepseek | openrouter | gemini | groq
#   (the last five are OpenAI-compatible presets that fill in LLM_BASE_URL)
LLM_PROVIDER=
# The model ID exactly as your provider names it.
LLM_MODEL=
LLM_API_KEY=
# Required for openai-compatible (e.g. a local server); overrides a preset.
LLM_BASE_URL=
# Optional. Sent only if set: Anthropic "effort" or OpenAI-style "reasoning_effort".
LLM_REASONING_EFFORT=
AGENT_BRAIN=

# ---------- Chat approvals (testnet) ----------
# Lets chat apps (Telegram first) approve testnet USDC sends. Each user turns it
# on once on the Channels page: their own wallet adds a Wura agent key (derived
# from this secret and their user ID, never stored) as a second signer that can
# make payments but can't change signers. Caps are still checked by the server.
# 32+ random characters, e.g. `openssl rand -hex 32`. Testnet only; if this
# leaked, opted-in testnet accounts could be drained. Leave empty to turn it off.
# Use the SAME value in Production and Preview and never change it while anyone
# has chat approvals on: a new secret means a new key, and the old one would stay
# on their account with no way to remove it from the app.
AGENT_KEY_SECRET=
# Local testing only: enables /api/dev/chat-approve (never on Vercel).
ALLOW_DEV_ROUTES=

# ---------- Telegram bot ----------
# All three are needed to turn the bot on. Without them the webhook returns 404
# and the Channels page hides the Telegram card.
# Bot token from @BotFather. Never expose this to the browser.
TELEGRAM_BOT_TOKEN=
# The bot's username, without the @.
TELEGRAM_BOT_USERNAME=
# Shared secret Telegram echoes back on every webhook call: 16+ characters of
# letters, digits, _ or -. Register it with `node scripts/telegram-webhook.mjs set <origin>`.
TELEGRAM_WEBHOOK_SECRET=

# Public https origin of this app (e.g. https://wurapay.xyz), used for the MCP
# connector's OAuth addresses, the links the bot sends and payment links (required on mainnet). Without it, OAuth uses
# the request's own origin and the bot uses the Vercel URL.
APP_URL=

# Wura's reserve (D1). A separate Stellar secret key (S...) for the treasury account that
# sponsors each beta user's account and trustlines, so they never need XLM. It signs the
# sponsored setup transaction only, and must differ from every other secret. Without it,
# testnet uses Friendbot and mainnet wallet setup is unavailable.
TREASURY_SECRET=
# XLM given to a new account for network fees (default 0.5).
SPONSOR_FEE_XLM=
# Stop sponsoring when the treasury's free XLM would fall below this (default 20). Logged as an error.
TREASURY_MIN_XLM=
# Most accounts the treasury will sponsor (default 10, the beta size).
SPONSOR_MAX_ACCOUNTS=
# Emails allowed to be sponsored, comma separated. Empty means nobody on mainnet.
BETA_ALLOWLIST=

# Payment links (M5). Links are built from APP_URL (above). Mainnet refuses to start without it (https, not localhost).
# Secret for GET /api/cron/links, which checks open links on Horizon. Send it as
# "Authorization: Bearer <value>" from a scheduler (a Vercel cron does this by itself when
# CRON_SECRET is set). Empty turns the route off; links are then also checked whenever
# someone opens the pay page or their links list.
CRON_SECRET=
